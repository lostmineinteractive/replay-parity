{
  "name": "@replay-parity/shrink",
  "version": "0.1.0",
  "private": false,
  "description": "Bounded delta debugging that reduces a failing replay to a reduced reproduction.",
  "keywords": [
    "replay",
    "diff",
    "latency",
    "parity",
    "regression",
    "recording",
    "shadow-traffic",
    "delta-debugging",
    "reduction"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seesharp15/replay-parity.git",
    "directory": "packages/shrink"
  },
  "homepage": "https://github.com/seesharp15/replay-parity#readme",
  "bugs": {
    "url": "https://github.com/seesharp15/replay-parity/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/!(*.test).*"
  ],
  "dependencies": {
    "@replay-parity/core": "workspace:*",
    "@replay-parity/replay": "workspace:*"
  },
  "devDependencies": {
    "@replay-parity/demo-candidate": "workspace:*"
  }
}
