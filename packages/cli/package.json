{
  "name": "@replay-parity/cli",
  "version": "0.1.0",
  "private": false,
  "description": "The rp command line: capture, replay, report, invariants, shrink, agent.",
  "keywords": [
    "replay",
    "diff",
    "latency",
    "parity",
    "regression",
    "recording",
    "shadow-traffic",
    "cli",
    "rp"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seesharp15/replay-parity.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/seesharp15/replay-parity#readme",
  "bugs": {
    "url": "https://github.com/seesharp15/replay-parity/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "rp": "./dist/src/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/!(*.test).*"
  ],
  "dependencies": {
    "@replay-parity/agent": "workspace:*",
    "@replay-parity/capture": "workspace:*",
    "@replay-parity/core": "workspace:*",
    "@replay-parity/invariants": "workspace:*",
    "@replay-parity/replay": "workspace:*",
    "@replay-parity/report": "workspace:*",
    "@replay-parity/shrink": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@replay-parity/demo-candidate": "workspace:*",
    "@replay-parity/demo-reference": "workspace:*"
  }
}
