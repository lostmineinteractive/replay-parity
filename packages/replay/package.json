{
  "name": "@replay-parity/replay",
  "version": "0.1.0",
  "private": false,
  "description": "Replay engine, adapters, and run writer for replay-parity.",
  "keywords": [
    "replay",
    "diff",
    "latency",
    "parity",
    "regression",
    "recording",
    "shadow-traffic",
    "http",
    "redis-streams",
    "adapter"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seesharp15/replay-parity.git",
    "directory": "packages/replay"
  },
  "homepage": "https://github.com/seesharp15/replay-parity#readme",
  "bugs": {
    "url": "https://github.com/seesharp15/replay-parity/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/!(*.test).*"
  ],
  "dependencies": {
    "@replay-parity/core": "workspace:*",
    "@replay-parity/invariants": "workspace:*",
    "redis": "^6.3.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@replay-parity/demo-candidate": "workspace:*",
    "@replay-parity/demo-reference": "workspace:*"
  }
}
